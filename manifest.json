{
  "manifest_version": 3,
  "name": "Clean FB",
  "description": "Hide ads, Reels, and friend recommendations on Facebook.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "action": {
    "default_title": "Clean FB",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
